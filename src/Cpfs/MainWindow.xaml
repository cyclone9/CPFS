<ui:FluentWindow
  x:Class="Cpfs.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Cpfs"
  xmlns:pages="clr-namespace:Cpfs.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="{Binding [App_Title], Source={x:Static local:Loc.Instance}}"
  Width="1000"
  Height="700"
  MinWidth="560"
  MinHeight="420"
  ExtendsContentIntoTitleBar="True"
  PreviewMouseWheel="OnPreviewMouseWheel"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Icon="pack://application:,,,/Assets/cpfs.ico"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      x:Name="AppTitleBar"
      Grid.Row="0"
      Title="{Binding [App_Title], Source={x:Static local:Loc.Instance}}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="{StaticResource CpfsAppIcon}" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ui:NavigationView
      x:Name="RootNavigation"
      Grid.Row="1"
      IsBackButtonVisible="Collapsed"
      OpenPaneLength="240">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem
          AutomationProperties.Name="{Binding [Nav_Setup], Source={x:Static local:Loc.Instance}}"
          Content="{Binding [Nav_Setup], Source={x:Static local:Loc.Instance}}"
          Icon="{ui:SymbolIcon WindowWrench24}"
          NavigationCacheMode="Enabled"
          TargetPageType="{x:Type pages:SetupPage}" />
        <ui:NavigationViewItem
          AutomationProperties.Name="{Binding [Nav_Monitor], Source={x:Static local:Loc.Instance}}"
          Content="{Binding [Nav_Monitor], Source={x:Static local:Loc.Instance}}"
          Icon="{ui:SymbolIcon Pulse24}"
          NavigationCacheMode="Enabled"
          TargetPageType="{x:Type pages:MonitorPage}" />
        <ui:NavigationViewItem
          AutomationProperties.Name="{Binding [Nav_Connect], Source={x:Static local:Loc.Instance}}"
          Content="{Binding [Nav_Connect], Source={x:Static local:Loc.Instance}}"
          Icon="{ui:SymbolIcon QrCode24}"
          NavigationCacheMode="Enabled"
          TargetPageType="{x:Type pages:ConnectPage}" />
        <ui:NavigationViewItem
          AutomationProperties.Name="{Binding [Nav_Uninstall], Source={x:Static local:Loc.Instance}}"
          Content="{Binding [Nav_Uninstall], Source={x:Static local:Loc.Instance}}"
          Icon="{ui:SymbolIcon Delete24}"
          NavigationCacheMode="Enabled"
          TargetPageType="{x:Type pages:UninstallPage}" />
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem
          AutomationProperties.Name="{Binding [Nav_Preferences], Source={x:Static local:Loc.Instance}}"
          Content="{Binding [Nav_Preferences], Source={x:Static local:Loc.Instance}}"
          Icon="{ui:SymbolIcon Settings24}"
          NavigationCacheMode="Enabled"
          TargetPageType="{x:Type pages:PreferencesPage}" />
        <ui:NavigationViewItem
          AutomationProperties.Name="{Binding [Nav_Advanced], Source={x:Static local:Loc.Instance}}"
          Content="{Binding [Nav_Advanced], Source={x:Static local:Loc.Instance}}"
          Icon="{ui:SymbolIcon Wrench24}"
          NavigationCacheMode="Enabled"
          TargetPageType="{x:Type pages:AdvancedPage}" />
        <ui:NavigationViewItem
          AutomationProperties.Name="{Binding [Nav_About], Source={x:Static local:Loc.Instance}}"
          Content="{Binding [Nav_About], Source={x:Static local:Loc.Instance}}"
          Icon="{ui:SymbolIcon Info24}"
          NavigationCacheMode="Enabled"
          TargetPageType="{x:Type pages:AboutPage}" />
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>

    <!--  The start-up update check's note, only when a newer release exists (MainWindow.CheckForUpdateAtStart).  -->
    <StackPanel
      x:Name="UpdateNote"
      Grid.Row="1"
      MaxWidth="420"
      Margin="16"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      Visibility="Collapsed">
      <ui:InfoBar
        x:Name="UpdateBar"
        Title="{Binding [Update_InfoTitle], Source={x:Static local:Loc.Instance}}"
        IsClosable="True"
        IsOpen="True"
        Severity="Informational" />
      <ui:Button
        Margin="0,4,0,0"
        HorizontalAlignment="Right"
        AutomationProperties.Name="{Binding [Update_OpenRelease], Source={x:Static local:Loc.Instance}}"
        Click="OnOpenUpdate"
        Content="{Binding [Update_OpenRelease], Source={x:Static local:Loc.Instance}}"
        Icon="{ui:SymbolIcon Open24}" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
