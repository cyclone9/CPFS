<Page
  x:Class="Cpfs.Pages.SetupPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Cpfs"
  xmlns:pages="clr-namespace:Cpfs.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <DataTemplate x:Key="RowTemplate" DataType="{x:Type pages:RowView}">
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="120" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Margin="0,0,12,0"
          Style="{StaticResource CardTitle}"
          FontWeight="Normal"
          Text="{Binding Label}"
          Visibility="{Binding LabelIsText, Converter={StaticResource Visible}}" />
        <TextBlock
          Margin="0,0,12,0"
          Style="{StaticResource DataValue}"
          Text="{Binding Label}"
          Visibility="{Binding LabelIsData, Converter={StaticResource Visible}}" />
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource CardValue}" Text="{Binding Value}" Visibility="{Binding ValueIsText, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource DataValue}" Text="{Binding Value}" Visibility="{Binding ValueIsData, Converter={StaticResource Visible}}" />
          <Border Style="{StaticResource Badge}" Visibility="{Binding HasBadge, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Badge}" />
          </Border>
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!--
      A collapsible section: the header shows the name, a one-line summary (or "Reading..." until the section is
      read) and its status badge; the rows are inside. The header's toggle button is the one tab stop.
    -->
    <DataTemplate x:Key="SectionTemplate" DataType="{x:Type pages:SectionView}">
      <ui:CardExpander
        Margin="0,0,0,4"
        AutomationProperties.HelpText="{Binding HelpText}"
        AutomationProperties.Name="{Binding Title}"
        Focusable="False"
        IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
        Loaded="OnSectionLoaded"
        PreviewKeyDown="OnSectionKeyDown">
        <ui:CardExpander.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Summary}" Visibility="{Binding HasSummary, Converter={StaticResource Visible}}" />
            </StackPanel>
            <Border
              Grid.Column="1"
              Margin="12,0,8,0"
              VerticalAlignment="Center"
              Visibility="{Binding HasBadge, Converter={StaticResource Visible}}">
              <Border.Style>
                <Style BasedOn="{StaticResource Badge}" TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding BadgeKind}" Value="Ok">
                      <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BadgeKind}" Value="Missing">
                      <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorNeutralBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BadgeKind}" Value="Failed">
                      <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Badge}" />
            </Border>
          </Grid>
        </ui:CardExpander.Header>
        <StackPanel>
          <TextBlock Margin="0" Style="{StaticResource CardDescription}" Text="{Binding Description}" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
          <!--  An ItemsControl has no ScrollViewer of its own: the page scrolls, not the card.  -->
          <ItemsControl
            Margin="0,12,0,0"
            Focusable="False"
            ItemTemplate="{StaticResource RowTemplate}"
            ItemsSource="{Binding Rows}" />
        </StackPanel>
      </ui:CardExpander>
    </DataTemplate>

    <!--  One plan item: what happens (badge), to what, old and new value, and why. An Ask item has its tick box.  -->
    <DataTemplate x:Key="PlanItemTemplate" DataType="{x:Type pages:PlanItemView}">
      <Grid Margin="0,0,0,8" AutomationProperties.HelpText="{Binding HelpText}" AutomationProperties.Name="{Binding Subject}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="96" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Margin="0,0,12,0" VerticalAlignment="Top">
          <Border.Style>
            <Style BasedOn="{StaticResource Badge}" TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Keep">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Ask">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorNeutralBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="CannotPlan">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Badge}" />
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Subject}" Visibility="{Binding SubjectIsText, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource DataValue}" FontWeight="SemiBold" Text="{Binding Subject}" Visibility="{Binding SubjectIsData, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource CardValue}" Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Reason}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding BackupNote}" Visibility="{Binding HasBackupNote, Converter={StaticResource Visible}}" />
          <CheckBox
            Margin="0,4,0,0"
            AutomationProperties.HelpText="{Binding Reason}"
            AutomationProperties.Name="{Binding AskName}"
            Checked="OnPlanTickChanged"
            Content="{Binding [Setup_Plan_AskDo], Source={x:Static local:Loc.Instance}}"
            IsChecked="{Binding Ticked, Mode=OneWay}"
            IsEnabled="{Binding AskEnabled}"
            Tag="{Binding Key}"
            Unchecked="OnPlanTickChanged"
            Visibility="{Binding IsAsk, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding LaterNote}" Visibility="{Binding HasLaterNote, Converter={StaticResource Visible}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!--  One row of Apply's progress: its state (badge), the item, and the error when it failed.  -->
    <DataTemplate x:Key="StepTemplate" DataType="{x:Type pages:StepView}">
      <Grid Margin="0,0,0,6" AutomationProperties.HelpText="{Binding State}" AutomationProperties.Name="{Binding Subject}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="112" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Margin="0,0,12,0" VerticalAlignment="Top">
          <Border.Style>
            <Style BasedOn="{StaticResource Badge}" TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding StateKind}" Value="Done">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Kept">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Deferred">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorNeutralBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Unsupported">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Skipped">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Partial">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Failed">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Style="{StaticResource BadgeText}" Text="{Binding State}" />
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Subject}" Visibility="{Binding SubjectIsText, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource DataValue}" Text="{Binding Subject}" Visibility="{Binding SubjectIsData, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource CardValue}" Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PlanGroupTemplate" DataType="{x:Type pages:PlanGroupView}">
      <ui:Card Margin="0,0,0,4" AutomationProperties.Name="{Binding Title}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Summary}" />
          <ItemsControl
            Margin="0,12,0,0"
            Focusable="False"
            ItemTemplate="{StaticResource PlanItemTemplate}"
            ItemsSource="{Binding Items}" />
        </StackPanel>
      </ui:Card>
    </DataTemplate>
  </Page.Resources>

  <StackPanel Margin="24,16,24,24">
    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Setup_Title], Source={x:Static local:Loc.Instance}}" />

    <ui:InfoBar
      Margin="0,0,0,8"
      IsClosable="False"
      IsOpen="True"
      Message="{Binding [Setup_ReadOnly_Msg], Source={x:Static local:Loc.Instance}}"
      Severity="Informational"
      Title="{Binding [Setup_ReadOnly_Title], Source={x:Static local:Loc.Instance}}" />

    <ui:CardControl x:Name="AdminCard" Margin="0,0,0,4" Icon="{ui:SymbolIcon Shield24}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock x:Name="AdminTitle" Style="{StaticResource CardTitle}" />
          <TextBlock x:Name="AdminDescription" Style="{StaticResource CardDescription}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button
        x:Name="ElevateButton"
        Appearance="Primary"
        AutomationProperties.Name="{Binding [Setup_Admin_Button], Source={x:Static local:Loc.Instance}}"
        Click="OnContinueAsAdministrator"
        Content="{Binding [Setup_Admin_Button], Source={x:Static local:Loc.Instance}}"
        Icon="{ui:SymbolIcon Shield24}" />
    </ui:CardControl>

    <ui:InfoBar x:Name="AdminResult" Margin="0,0,0,4" IsClosable="True" IsOpen="False" />

    <ui:Card x:Name="HandOverCard" Margin="0,0,0,4" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_HandOver_Title], Source={x:Static local:Loc.Instance}}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_HandOver_Desc], Source={x:Static local:Loc.Instance}}" />
        <ItemsControl
          x:Name="HandOverRows"
          Margin="0,12,0,0"
          Focusable="False"
          ItemTemplate="{StaticResource RowTemplate}" />
      </StackPanel>
    </ui:Card>


    <TextBlock Margin="0,16,0,4" Style="{StaticResource CardTitle}" FontSize="20" Text="{Binding [Setup_Plan_Title], Source={x:Static local:Loc.Instance}}" />
    <TextBlock Margin="0,0,0,8" Style="{StaticResource CardDescription}" Text="{Binding [Setup_Plan_Desc], Source={x:Static local:Loc.Instance}}" />

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock x:Name="SharePathLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_SharePath], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_SharePath_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel MinWidth="240" MaxWidth="360">
        <TextBox
          x:Name="SharePathBox"
          AutomationProperties.LabeledBy="{Binding ElementName=SharePathLabel}" FlowDirection="LeftToRight" FontFamily="{x:Static local:Theming.MonoFamily}"
          TextChanged="OnFormChanged" />
        <TextBlock x:Name="SharePathError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock x:Name="ShareNameLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_ShareName], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel MinWidth="240" MaxWidth="360">
        <TextBox
          x:Name="ShareNameBox"
          AutomationProperties.LabeledBy="{Binding ElementName=ShareNameLabel}" FlowDirection="LeftToRight" FontFamily="{x:Static local:Theming.MonoFamily}"
          TextChanged="OnFormChanged" />
        <TextBlock x:Name="ShareNameError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock x:Name="SmbUserLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_SmbUser], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_SmbUser_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel MinWidth="240" MaxWidth="360">
        <TextBox
          x:Name="SmbUserBox"
          AutomationProperties.LabeledBy="{Binding ElementName=SmbUserLabel}" FlowDirection="LeftToRight" FontFamily="{x:Static local:Theming.MonoFamily}"
          TextChanged="OnFormChanged" />
        <TextBlock x:Name="SmbUserError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock x:Name="PasswordLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_Password], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_Password_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel MinWidth="240" MaxWidth="360">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <PasswordBox
            x:Name="PasswordBox1"
            AutomationProperties.Name="{Binding [Setup_Form_Password], Source={x:Static local:Loc.Instance}}"
            PasswordChanged="OnPasswordChanged" />
          <TextBox
            x:Name="PasswordPlain1"
            AutomationProperties.Name="{Binding [Setup_Form_Password], Source={x:Static local:Loc.Instance}}"
            Visibility="Collapsed" />
          <ui:Button
            x:Name="PasswordEye1"
            Grid.Column="1"
            Margin="4,0,0,0"
            VerticalAlignment="Stretch"
            Appearance="Transparent" />
        </Grid>
        <TextBlock Margin="0,8,0,4" Style="{StaticResource CardValue}" Text="{Binding [Setup_Form_PasswordRepeat], Source={x:Static local:Loc.Instance}}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <PasswordBox
            x:Name="PasswordBox2"
            AutomationProperties.Name="{Binding [Setup_Form_PasswordRepeat], Source={x:Static local:Loc.Instance}}"
            PasswordChanged="OnPasswordChanged" />
          <TextBox
            x:Name="PasswordPlain2"
            AutomationProperties.Name="{Binding [Setup_Form_PasswordRepeat], Source={x:Static local:Loc.Instance}}"
            Visibility="Collapsed" />
          <ui:Button
            x:Name="PasswordEye2"
            Grid.Column="1"
            Margin="4,0,0,0"
            VerticalAlignment="Stretch"
            Appearance="Transparent" />
        </Grid>
        <TextBlock x:Name="PasswordError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock x:Name="StrictLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_Strict], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_Strict_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel MinWidth="240" MaxWidth="360">
        <ui:ToggleSwitch
          x:Name="StrictSwitch"
          AutomationProperties.LabeledBy="{Binding ElementName=StrictLabel}"
          Checked="OnFormChanged"
          Unchecked="OnFormChanged" />
        <TextBlock x:Name="StrictError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock x:Name="AutoPrivateLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_AutoPrivate], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_AutoPrivate_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel MinWidth="240" MaxWidth="360">
        <ui:ToggleSwitch
          x:Name="AutoPrivateSwitch"
          AutomationProperties.LabeledBy="{Binding ElementName=AutoPrivateLabel}"
          Checked="OnFormChanged"
          Unchecked="OnFormChanged" />
        <TextBlock x:Name="AutoPrivateError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock x:Name="DriveLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_Drive], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_Drive_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel MinWidth="240" MaxWidth="360">
        <ui:ToggleSwitch
          x:Name="DriveSwitch"
          IsEnabled="False"
          AutomationProperties.HelpText="{Binding [Setup_Plan_QuickAccessLater], Source={x:Static local:Loc.Instance}}"
          AutomationProperties.LabeledBy="{Binding ElementName=DriveLabel}"
          Checked="OnFormChanged"
          Unchecked="OnFormChanged" />
        <ComboBox
          x:Name="DriveLetterBox"
          IsEnabled="False"
          AutomationProperties.HelpText="{Binding [Setup_Plan_QuickAccessLater], Source={x:Static local:Loc.Instance}}"
          Margin="0,8,0,0"
          AutomationProperties.LabeledBy="{Binding ElementName=DriveLabel}"
          FlowDirection="LeftToRight"
          SelectionChanged="OnFormChanged" />
        <TextBlock x:Name="DriveError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
        <!--  The executor skips the drive and the shortcut until 0.6.0; the saved values stay visible.  -->
        <TextBlock Margin="0,4,0,0" Style="{StaticResource CardDescription}" Text="{Binding [Setup_Plan_QuickAccessLater], Source={x:Static local:Loc.Instance}}" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock x:Name="DriveNameLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_DriveName], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel MinWidth="240" MaxWidth="360">
        <TextBox
          x:Name="DriveNameBox"
          IsEnabled="False"
          AutomationProperties.HelpText="{Binding [Setup_Plan_QuickAccessLater], Source={x:Static local:Loc.Instance}}"
          AutomationProperties.LabeledBy="{Binding ElementName=DriveNameLabel}"
          TextChanged="OnFormChanged" />
        <TextBlock x:Name="DriveNameError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock x:Name="ShortcutLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_Shortcut], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel MinWidth="240" MaxWidth="360">
        <ui:ToggleSwitch
          x:Name="ShortcutSwitch"
          IsEnabled="False"
          AutomationProperties.HelpText="{Binding [Setup_Plan_QuickAccessLater], Source={x:Static local:Loc.Instance}}"
          AutomationProperties.LabeledBy="{Binding ElementName=ShortcutLabel}"
          Checked="OnFormChanged"
          Unchecked="OnFormChanged" />
        <TextBlock x:Name="ShortcutError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
        <TextBlock Margin="0,4,0,0" Style="{StaticResource CardDescription}" Text="{Binding [Setup_Plan_QuickAccessLater], Source={x:Static local:Loc.Instance}}" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock x:Name="ShortcutNameLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_ShortcutName], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel MinWidth="240" MaxWidth="360">
        <TextBox
          x:Name="ShortcutNameBox"
          IsEnabled="False"
          AutomationProperties.HelpText="{Binding [Setup_Plan_QuickAccessLater], Source={x:Static local:Loc.Instance}}"
          AutomationProperties.LabeledBy="{Binding ElementName=ShortcutNameLabel}"
          TextChanged="OnFormChanged" />
        <TextBlock x:Name="ShortcutNameError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
      </StackPanel>
    </ui:CardControl>

    <ui:InfoBar x:Name="PlanNotice" Margin="0,8,0,4" IsClosable="False" IsOpen="False" Severity="Warning" />

    <ui:CardControl Margin="0,8,0,4" Icon="{ui:SymbolIcon Play24}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock x:Name="PlanSummary" Style="{StaticResource CardTitle}" />
          <TextBlock x:Name="ApplyHint" Style="{StaticResource CardDescription}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel>
        <CheckBox
          x:Name="RestorePointBox"
          Margin="0,0,0,8"
          AutomationProperties.Name="{Binding [Apply_RestorePoint], Source={x:Static local:Loc.Instance}}"
          Content="{Binding [Apply_RestorePoint], Source={x:Static local:Loc.Instance}}"
          IsChecked="True" />
        <ui:Button
          x:Name="ApplyButton"
          Appearance="Primary"
          AutomationProperties.Name="{Binding [Setup_Plan_Apply], Source={x:Static local:Loc.Instance}}"
          Click="OnApply"
          Content="{Binding [Setup_Plan_Apply], Source={x:Static local:Loc.Instance}}"
          IsEnabled="False" />
      </StackPanel>
    </ui:CardControl>

    <ui:InfoBar x:Name="ApplyResult" Margin="0,0,0,4" IsClosable="True" IsOpen="False" />

    <ui:Card x:Name="ProgressCard" Margin="0,0,0,4" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Apply_ProgressTitle], Source={x:Static local:Loc.Instance}}" />
        <ItemsControl
          x:Name="ProgressList"
          Margin="0,12,0,0"
          Focusable="False"
          ItemTemplate="{StaticResource StepTemplate}" />
      </StackPanel>
    </ui:Card>

    <ItemsControl x:Name="PlanGroups" Focusable="False" ItemTemplate="{StaticResource PlanGroupTemplate}" />

    <TextBlock Margin="0,24,0,4" Style="{StaticResource CardTitle}" FontSize="20" Text="{Binding [Setup_State_Title], Source={x:Static local:Loc.Instance}}" />

    <WrapPanel Margin="0,8,0,8">
      <ui:Button
        x:Name="RefreshButton"
        Margin="0,0,12,0"
        AutomationProperties.Name="{Binding [Setup_Refresh], Source={x:Static local:Loc.Instance}}"
        Click="OnRefresh"
        Content="{Binding [Setup_Refresh], Source={x:Static local:Loc.Instance}}"
        Icon="{ui:SymbolIcon ArrowClockwise24}" />
      <ui:Button
        x:Name="ExpandAllButton"
        Margin="0,0,8,0"
        AutomationProperties.Name="{Binding [Setup_ExpandAll], Source={x:Static local:Loc.Instance}}"
        Click="OnExpandAll"
        Content="{Binding [Setup_ExpandAll], Source={x:Static local:Loc.Instance}}"
        Icon="{ui:SymbolIcon ArrowMaximizeVertical24}" />
      <ui:Button
        x:Name="CollapseAllButton"
        Margin="0,0,12,0"
        AutomationProperties.Name="{Binding [Setup_CollapseAll], Source={x:Static local:Loc.Instance}}"
        Click="OnCollapseAll"
        Content="{Binding [Setup_CollapseAll], Source={x:Static local:Loc.Instance}}"
        Icon="{ui:SymbolIcon ArrowMinimizeVertical24}" />
      <ui:ProgressRing
        x:Name="Busy"
        Width="20"
        Height="20"
        IsIndeterminate="True"
        Visibility="Collapsed" />
      <TextBlock
        x:Name="BusyText"
        Margin="8,0,0,0"
        VerticalAlignment="Center"
        Style="{StaticResource CardValue}"
        Text="{Binding [Setup_Reading], Source={x:Static local:Loc.Instance}}"
        Visibility="Collapsed" />
    </WrapPanel>

    <ItemsControl x:Name="Sections" Focusable="False" ItemTemplate="{StaticResource SectionTemplate}" />
  </StackPanel>
</Page>
