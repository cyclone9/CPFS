<Page
  x:Class="Cpfs.Pages.SetupPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Cpfs"
  xmlns:pages="clr-namespace:Cpfs.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!--  The slot beside a field's input; its margin is part of the shared size, so an empty slot keeps the inputs aligned.  -->
    <Style x:Key="FieldSlot" TargetType="StackPanel">
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!--  One plan item: what happens (badge), to what, old and new value, and why. An Ask item has its tick box.  -->
    <DataTemplate x:Key="PlanItemTemplate" DataType="{x:Type pages:PlanItemView}">
      <Grid Margin="0,0,0,8" AutomationProperties.HelpText="{Binding HelpText}" AutomationProperties.Name="{Binding Subject}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="96" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0" VerticalAlignment="Top" Orientation="Horizontal">
          <Border VerticalAlignment="Top">
            <Border.Style>
              <Style BasedOn="{StaticResource Badge}" TargetType="Border">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding BadgeKind}" Value="Keep">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding BadgeKind}" Value="Ask">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorNeutralBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding BadgeKind}" Value="CannotPlan">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Badge}" />
          </Border>
          <!--  The Windows convention for "needs administrator": the UAC shield.  -->
          <ui:SymbolIcon
            Margin="6,0,0,0"
            VerticalAlignment="Center"
            AutomationProperties.Name="{Binding [Common_NeedsAdmin], Source={x:Static local:Loc.Instance}}"
            FontSize="16"
            Symbol="Shield24"
            ToolTip="{Binding [Common_NeedsAdmin], Source={x:Static local:Loc.Instance}}"
            Visibility="{Binding NeedsAdmin, Converter={StaticResource Visible}}" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Subject}" Visibility="{Binding SubjectIsText, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource DataValue}" FontWeight="SemiBold" Text="{Binding Subject}" Visibility="{Binding SubjectIsData, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource CardValue}" Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Reason}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding BackupNote}" Visibility="{Binding HasBackupNote, Converter={StaticResource Visible}}" />
          <CheckBox
            Margin="0,4,0,0"
            AutomationProperties.HelpText="{Binding Reason}"
            AutomationProperties.Name="{Binding AskName}"
            Checked="OnPlanTickChanged"
            Content="{Binding [Setup_Plan_AskDo], Source={x:Static local:Loc.Instance}}"
            IsChecked="{Binding Ticked, Mode=OneWay}"
            Tag="{Binding Key}"
            Unchecked="OnPlanTickChanged"
            Visibility="{Binding IsAsk, Converter={StaticResource Visible}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!--  One row of Apply's progress: its state (badge), the item, and the error when it failed.  -->
    <DataTemplate x:Key="StepTemplate" DataType="{x:Type pages:StepView}">
      <Grid Margin="0,0,0,6" AutomationProperties.HelpText="{Binding State}" AutomationProperties.Name="{Binding Subject}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="112" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Margin="0,0,12,0" VerticalAlignment="Top">
          <Border.Style>
            <Style BasedOn="{StaticResource Badge}" TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding StateKind}" Value="Done">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Kept">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Deferred">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorNeutralBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Unsupported">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Skipped">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Partial">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Failed">
                  <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Style="{StaticResource BadgeText}" Text="{Binding State}" />
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Subject}" Visibility="{Binding SubjectIsText, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource DataValue}" Text="{Binding Subject}" Visibility="{Binding SubjectIsData, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource CardValue}" Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!--  One decision for Your decisions: the tick box with what it does and why. Never collapsed.  -->
    <DataTemplate x:Key="DecisionTemplate" DataType="{x:Type pages:PlanItemView}">
      <CheckBox
        Margin="0,0,0,8"
        AutomationProperties.HelpText="{Binding Reason}"
        AutomationProperties.Name="{Binding AskName}"
        Checked="OnPlanTickChanged"
        IsChecked="{Binding Ticked, Mode=OneWay}"
        Tag="{Binding Key}"
        Unchecked="OnPlanTickChanged">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Subject}" Visibility="{Binding SubjectIsText, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource DataValue}" FontWeight="SemiBold" Text="{Binding Subject}" Visibility="{Binding SubjectIsData, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource CardValue}" Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Reason}" />
        </StackPanel>
      </CheckBox>
    </DataTemplate>

    <DataTemplate x:Key="PlanGroupTemplate" DataType="{x:Type pages:PlanGroupView}">
      <ui:Card Margin="0,0,0,4" AutomationProperties.Name="{Binding Title}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Summary}" />
          <ItemsControl
            Margin="0,12,0,0"
            Focusable="False"
            ItemTemplate="{StaticResource PlanItemTemplate}"
            ItemsSource="{Binding Items}" />
        </StackPanel>
      </ui:Card>
    </DataTemplate>
  </Page.Resources>

  <StackPanel Margin="24,16,24,24" Grid.IsSharedSizeScope="True">
    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Setup_Title], Source={x:Static local:Loc.Instance}}" />

    <ui:CardControl x:Name="AdminCard" Margin="0,0,0,4" Icon="{ui:SymbolIcon Shield24}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_Admin_Title], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Admin_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button
        x:Name="ElevateButton"
        Appearance="Primary"
        AutomationProperties.Name="{Binding [Setup_Admin_Button], Source={x:Static local:Loc.Instance}}"
        Click="OnContinueAsAdministrator"
        Content="{Binding [Setup_Admin_Button], Source={x:Static local:Loc.Instance}}"
        Icon="{ui:SymbolIcon Shield24}" />
    </ui:CardControl>

    <ui:InfoBar x:Name="AdminResult" Margin="0,0,0,4" IsClosable="True" IsOpen="False" />

    <!--  First install only: what this page is for, in one line.  -->
    <ui:Card x:Name="WelcomeCard" Margin="0,0,0,4" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image
          x:Name="WelcomeSymbol"
          Width="48"
          Height="48"
          Margin="0,0,16,0"
          VerticalAlignment="Top"
          FlowDirection="LeftToRight"
          AutomationProperties.Name="{Binding [About_Brand_SymbolName], Source={x:Static local:Loc.Instance}}"
          Source="{StaticResource CpfsSymbolOnDark}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource CardTitle}" FontSize="20" Text="{Binding [Setup_Welcome_Title], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Welcome_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </Grid>
    </ui:Card>

    <!--  Field cards: the title, then the field in a column shared by every card (FieldCardPanel); each input has the
          same width because the button slot beside it is one shared size group (FieldSlot), empty or not.  -->
    <ui:Card Margin="0,0,0,4">
      <local:FieldCardPanel>
        <StackPanel>
          <TextBlock x:Name="SharePathLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_SharePath], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_SharePath_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="FieldSlot" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="SharePathBox"
              AutomationProperties.LabeledBy="{Binding ElementName=SharePathLabel}"
              FlowDirection="LeftToRight"
              FontFamily="{x:Static local:Theming.MonoFamily}"
              TextChanged="OnFormChanged" />
            <StackPanel Grid.Column="1" Style="{StaticResource FieldSlot}">
              <ui:Button
                x:Name="BrowseButton"
                VerticalAlignment="Stretch"
                AutomationProperties.HelpText="{Binding [Setup_Form_Browse_Help], Source={x:Static local:Loc.Instance}}"
                AutomationProperties.Name="{Binding [Setup_Form_Browse], Source={x:Static local:Loc.Instance}}"
                Click="OnBrowse"
                Content="{Binding [Setup_Form_Browse], Source={x:Static local:Loc.Instance}}"
                Icon="{ui:SymbolIcon FolderOpen24}" />
            </StackPanel>
          </Grid>
          <TextBlock x:Name="SharePathError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
          <TextBlock
            x:Name="BrowseError"
            Margin="0,4,0,0"
            AutomationProperties.LiveSetting="Assertive"
            Style="{StaticResource ErrorText}"
            Visibility="Collapsed" />
        </StackPanel>
      </local:FieldCardPanel>
    </ui:Card>

    <ui:Card Margin="0,0,0,4">
      <local:FieldCardPanel>
        <StackPanel>
          <TextBlock x:Name="ShareNameLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_ShareName], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_ShareName_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="FieldSlot" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="ShareNameBox"
              AutomationProperties.LabeledBy="{Binding ElementName=ShareNameLabel}"
              FlowDirection="LeftToRight"
              FontFamily="{x:Static local:Theming.MonoFamily}"
              TextChanged="OnFormChanged" />
            <StackPanel Grid.Column="1" Style="{StaticResource FieldSlot}">
              <ui:Button
                VerticalAlignment="Stretch"
                Appearance="Transparent"
                Icon="{ui:SymbolIcon Dismiss24}"
                AutomationProperties.Name="{Binding [Setup_Form_ClearShareName], Source={x:Static local:Loc.Instance}}"
                Click="OnClearShareName"
                ToolTip="{Binding [Setup_Form_ClearShareName], Source={x:Static local:Loc.Instance}}" />
            </StackPanel>
          </Grid>
          <TextBlock x:Name="ShareNameError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
        </StackPanel>
      </local:FieldCardPanel>
    </ui:Card>

    <ui:Card Margin="0,0,0,4">
      <local:FieldCardPanel>
        <StackPanel>
          <TextBlock x:Name="SmbUserLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_SmbUser], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_SmbUser_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="FieldSlot" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="SmbUserBox"
              AutomationProperties.LabeledBy="{Binding ElementName=SmbUserLabel}"
              FlowDirection="LeftToRight"
              FontFamily="{x:Static local:Theming.MonoFamily}"
              TextChanged="OnFormChanged" />
            <StackPanel Grid.Column="1" Style="{StaticResource FieldSlot}">
              <ui:Button
                VerticalAlignment="Stretch"
                Appearance="Transparent"
                Icon="{ui:SymbolIcon Dismiss24}"
                AutomationProperties.Name="{Binding [Setup_Form_ClearSmbUser], Source={x:Static local:Loc.Instance}}"
                Click="OnClearSmbUser"
                ToolTip="{Binding [Setup_Form_ClearSmbUser], Source={x:Static local:Loc.Instance}}" />
            </StackPanel>
          </Grid>
          <TextBlock x:Name="SmbUserError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
        </StackPanel>
      </local:FieldCardPanel>
    </ui:Card>

    <ui:Card Margin="0,0,0,4">
      <local:FieldCardPanel>
        <StackPanel>
          <TextBlock x:Name="PasswordLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_Password], Source={x:Static local:Loc.Instance}}" />
          <TextBlock x:Name="PasswordDesc" Style="{StaticResource CardDescription}" />
        </StackPanel>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="FieldSlot" />
            </Grid.ColumnDefinitions>
            <PasswordBox
              x:Name="PasswordInput"
              AutomationProperties.Name="{Binding [Setup_Form_Password], Source={x:Static local:Loc.Instance}}"
              PasswordChanged="OnPasswordChanged" />
            <TextBox
              x:Name="PasswordPlain"
              AutomationProperties.Name="{Binding [Setup_Form_Password], Source={x:Static local:Loc.Instance}}"
              Visibility="Collapsed" />
            <StackPanel Grid.Column="1" Style="{StaticResource FieldSlot}">
              <ui:Button
                x:Name="PasswordClear"
                VerticalAlignment="Stretch"
                Appearance="Transparent"
                Icon="{ui:SymbolIcon Dismiss24}"
                AutomationProperties.Name="{Binding [Setup_Form_ClearPassword], Source={x:Static local:Loc.Instance}}"
                ToolTip="{Binding [Setup_Form_ClearPassword], Source={x:Static local:Loc.Instance}}" />
              <ui:Button
                x:Name="PasswordEye"
                Margin="4,0,0,0"
                VerticalAlignment="Stretch"
                Appearance="Transparent" />
            </StackPanel>
          </Grid>
          <TextBlock x:Name="PasswordError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
        </StackPanel>
      </local:FieldCardPanel>
    </ui:Card>

    <ui:Card Margin="0,0,0,4">
      <local:FieldCardPanel>
        <StackPanel>
          <TextBlock x:Name="DriveLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_Drive], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_Drive_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
        <StackPanel>
          <ui:ToggleSwitch
            x:Name="DriveSwitch"
            AutomationProperties.LabeledBy="{Binding ElementName=DriveLabel}"
            Checked="OnFormChanged"
            Unchecked="OnFormChanged" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="FieldSlot" />
            </Grid.ColumnDefinitions>
            <ComboBox
              x:Name="DriveLetterBox"
              AutomationProperties.LabeledBy="{Binding ElementName=DriveLabel}"
              FlowDirection="LeftToRight"
              IsEnabled="{Binding IsChecked, ElementName=DriveSwitch}"
              SelectionChanged="OnFormChanged" />
            <StackPanel Grid.Column="1" Style="{StaticResource FieldSlot}" />
          </Grid>
          <TextBlock x:Name="DriveError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
        </StackPanel>
      </local:FieldCardPanel>
    </ui:Card>

    <ui:Card Margin="0,0,0,4">
      <local:FieldCardPanel>
        <TextBlock x:Name="DriveNameLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_DriveName], Source={x:Static local:Loc.Instance}}" />
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="FieldSlot" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="DriveNameBox"
              AutomationProperties.LabeledBy="{Binding ElementName=DriveNameLabel}"
              IsEnabled="{Binding IsChecked, ElementName=DriveSwitch}"
              TextChanged="OnFormChanged" />
            <StackPanel Grid.Column="1" Style="{StaticResource FieldSlot}" />
          </Grid>
          <TextBlock x:Name="DriveNameError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
        </StackPanel>
      </local:FieldCardPanel>
    </ui:Card>

    <ui:Card Margin="0,0,0,4">
      <local:FieldCardPanel>
        <TextBlock x:Name="ShortcutLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_Shortcut], Source={x:Static local:Loc.Instance}}" />
        <StackPanel>
          <ui:ToggleSwitch
            x:Name="ShortcutSwitch"
            AutomationProperties.LabeledBy="{Binding ElementName=ShortcutLabel}"
            Checked="OnFormChanged"
            Unchecked="OnFormChanged" />
          <TextBlock x:Name="ShortcutError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
        </StackPanel>
      </local:FieldCardPanel>
    </ui:Card>

    <ui:Card Margin="0,0,0,4">
      <local:FieldCardPanel>
        <TextBlock x:Name="ShortcutNameLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_ShortcutName], Source={x:Static local:Loc.Instance}}" />
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="FieldSlot" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="ShortcutNameBox"
              AutomationProperties.LabeledBy="{Binding ElementName=ShortcutNameLabel}"
              IsEnabled="{Binding IsChecked, ElementName=ShortcutSwitch}"
              TextChanged="OnFormChanged" />
            <StackPanel Grid.Column="1" Style="{StaticResource FieldSlot}" />
          </Grid>
          <TextBlock x:Name="ShortcutNameError" Margin="0,4,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
        </StackPanel>
      </local:FieldCardPanel>
    </ui:Card>

    <!--  Everything with a good default. It opens on its own when one of its fields needs attention.  -->
    <ui:CardExpander
      x:Name="MoreOptions"
      Margin="0,0,0,4"
      AutomationProperties.HelpText="{Binding [Setup_More_Desc], Source={x:Static local:Loc.Instance}}"
      AutomationProperties.Name="{Binding [Setup_More_Title], Source={x:Static local:Loc.Instance}}"
      Focusable="False"
      Icon="{ui:SymbolIcon Options24}">
      <ui:CardExpander.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_More_Title], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_More_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardExpander.Header>
      <StackPanel>
        <ui:Card Margin="0,0,0,4">
          <local:FieldCardPanel>
            <StackPanel>
              <TextBlock x:Name="StrictLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_Strict], Source={x:Static local:Loc.Instance}}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_Strict_Desc], Source={x:Static local:Loc.Instance}}" />
            </StackPanel>
            <ui:ToggleSwitch
              x:Name="StrictSwitch"
              AutomationProperties.LabeledBy="{Binding ElementName=StrictLabel}"
              Checked="OnFormChanged"
              Unchecked="OnFormChanged" />
          </local:FieldCardPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,4">
          <local:FieldCardPanel>
            <StackPanel>
              <TextBlock x:Name="AutoPrivateLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_AutoPrivate], Source={x:Static local:Loc.Instance}}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_AutoPrivate_Desc], Source={x:Static local:Loc.Instance}}" />
            </StackPanel>
            <ui:ToggleSwitch
              x:Name="AutoPrivateSwitch"
              AutomationProperties.LabeledBy="{Binding ElementName=AutoPrivateLabel}"
              Checked="OnFormChanged"
              Unchecked="OnFormChanged" />
          </local:FieldCardPanel>
        </ui:Card>

        <ui:Card Margin="0">
          <local:FieldCardPanel>
            <StackPanel>
              <TextBlock x:Name="ComputerNameLabel" Style="{StaticResource CardTitle}" Text="{Binding [Setup_Form_ComputerName], Source={x:Static local:Loc.Instance}}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_ComputerName_Desc], Source={x:Static local:Loc.Instance}}" />
            </StackPanel>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="FieldSlot" />
                </Grid.ColumnDefinitions>
                <TextBox
                  x:Name="ComputerNameBox"
                  AutomationProperties.HelpText="{Binding [Setup_Form_ComputerName_Later], Source={x:Static local:Loc.Instance}}"
                  AutomationProperties.LabeledBy="{Binding ElementName=ComputerNameLabel}"
                  FlowDirection="LeftToRight"
                  FontFamily="{x:Static local:Theming.MonoFamily}"
                  IsEnabled="False" />
                <StackPanel Grid.Column="1" Style="{StaticResource FieldSlot}" />
              </Grid>
              <TextBlock Margin="0,4,0,0" Style="{StaticResource CardDescription}" Text="{Binding [Setup_Form_ComputerName_Later], Source={x:Static local:Loc.Instance}}" />
            </StackPanel>
          </local:FieldCardPanel>
        </ui:Card>
      </StackPanel>
    </ui:CardExpander>

    <!--  Every Ask item of the plan, never collapsed, above the main button.  -->
    <ui:Card x:Name="DecisionsCard" Margin="0,8,0,4" AutomationProperties.Name="{Binding [Setup_Decisions_Title], Source={x:Static local:Loc.Instance}}" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Setup_Decisions_Title], Source={x:Static local:Loc.Instance}}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Decisions_Desc], Source={x:Static local:Loc.Instance}}" />
        <ItemsControl
          x:Name="Decisions"
          Margin="0,12,0,0"
          Focusable="False"
          ItemTemplate="{StaticResource DecisionTemplate}" />
      </StackPanel>
    </ui:Card>

    <ui:Card Margin="0,8,0,4">
      <StackPanel>
        <TextBlock x:Name="SummaryTitle" Style="{StaticResource CardTitle}" FontSize="16" />
        <TextBlock x:Name="SummaryBody" Margin="0,8,0,0" Style="{StaticResource Body}" />
        <TextBlock x:Name="ApplyHint" Style="{StaticResource CardDescription}" />
        <ProgressBar
          x:Name="ApplyBusy"
          Margin="0,8,0,0"
          AutomationProperties.Name="{Binding [Apply_Running], Source={x:Static local:Loc.Instance}}"
          IsIndeterminate="True"
          Visibility="Collapsed" />
        <CheckBox
          x:Name="RestorePointBox"
          Margin="0,12,0,8"
          AutomationProperties.Name="{Binding [Apply_RestorePoint], Source={x:Static local:Loc.Instance}}"
          Content="{Binding [Apply_RestorePoint], Source={x:Static local:Loc.Instance}}"
          IsChecked="True" />
        <ui:Button
          x:Name="ApplyButton"
          HorizontalAlignment="Left"
          Appearance="Primary"
          Click="OnApply"
          IsEnabled="False" />
      </StackPanel>
    </ui:Card>

    <ui:InfoBar x:Name="ApplyResult" Margin="0,0,0,4" IsClosable="True" IsOpen="False" />
    <WrapPanel x:Name="ResultActions" Margin="0,0,0,4" Visibility="Collapsed">
      <ui:Button
        x:Name="OpenConnectButton"
        Margin="0,0,8,4"
        Appearance="Primary"
        AutomationProperties.Name="{Binding [Setup_OpenConnect], Source={x:Static local:Loc.Instance}}"
        Click="OnOpenConnect"
        Content="{Binding [Setup_OpenConnect], Source={x:Static local:Loc.Instance}}"
        Icon="{ui:SymbolIcon QrCode24}"
        Visibility="Collapsed" />
      <ui:Button
        x:Name="CopyReportButton"
        Margin="0,0,8,4"
        AutomationProperties.Name="{Binding [About_Log_Copy], Source={x:Static local:Loc.Instance}}"
        Click="OnCopyReport"
        Content="{Binding [About_Log_Copy], Source={x:Static local:Loc.Instance}}"
        Icon="{ui:SymbolIcon Copy24}"
        Visibility="Collapsed" />
    </WrapPanel>

    <!--  The full plan and Apply's progress, collapsed unless "Always show details" is on.  -->
    <ui:CardExpander
      x:Name="DetailsExpander"
      Margin="0,4,0,4"
      AutomationProperties.HelpText="{Binding [Setup_Details_Desc], Source={x:Static local:Loc.Instance}}"
      AutomationProperties.Name="{Binding [Common_ShowDetails], Source={x:Static local:Loc.Instance}}"
      Focusable="False"
      Icon="{ui:SymbolIcon TextBulletListLtr24}">
      <ui:CardExpander.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Common_ShowDetails], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Setup_Details_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardExpander.Header>
      <StackPanel>
        <TextBlock x:Name="PlanCounts" Style="{StaticResource CardValue}" />
        <WrapPanel Margin="0,8,0,8">
          <ui:Button
            x:Name="RefreshButton"
            Margin="0,0,12,0"
            AutomationProperties.Name="{Binding [Setup_Refresh], Source={x:Static local:Loc.Instance}}"
            Click="OnRefresh"
            Content="{Binding [Setup_Refresh], Source={x:Static local:Loc.Instance}}"
            Icon="{ui:SymbolIcon ArrowClockwise24}" />
          <ui:ProgressRing
            x:Name="Busy"
            Width="20"
            Height="20"
            IsIndeterminate="True"
            Visibility="Collapsed" />
          <TextBlock
            x:Name="BusyText"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource CardValue}"
            Text="{Binding [Setup_Reading], Source={x:Static local:Loc.Instance}}"
            Visibility="Collapsed" />
        </WrapPanel>

        <ui:Card x:Name="ProgressCard" Margin="0,0,0,4" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Apply_ProgressTitle], Source={x:Static local:Loc.Instance}}" />
            <ItemsControl
              x:Name="ProgressList"
              Margin="0,12,0,0"
              Focusable="False"
              ItemTemplate="{StaticResource StepTemplate}" />
          </StackPanel>
        </ui:Card>

        <ItemsControl x:Name="PlanGroups" Focusable="False" ItemTemplate="{StaticResource PlanGroupTemplate}" />
      </StackPanel>
    </ui:CardExpander>
  </StackPanel>
</Page>
