<Page
  x:Class="Cpfs.Pages.AboutPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Cpfs"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Page.Resources>
    <Style x:Key="InfoName" BasedOn="{StaticResource CardTitle}" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,24,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="InfoData" BasedOn="{StaticResource DataValue}" TargetType="TextBlock">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <!--  A plain link in the value column: its text starts where the version's does (the padding is taken back).  -->
    <Style x:Key="InfoLink" TargetType="ui:HyperlinkButton" BasedOn="{StaticResource DefaultUiHyperlinkButtonStyle}">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="Padding" Value="4,4" />
      <Setter Property="Margin" Value="-4,0,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--  Licence texts: read-only, left to right, scrolled inside a fixed height (the window routes the wheel).  -->
    <Style x:Key="LicenceText" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="MaxHeight" Value="320" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="FlowDirection" Value="LeftToRight" />
      <Setter Property="FontFamily" Value="{x:Static local:Theming.MonoFamily}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Page.Resources>

  <StackPanel Margin="24,16,24,24">
    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Nav_About], Source={x:Static local:Loc.Instance}}" />

    <ui:Card Margin="0,0,0,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image
          x:Name="BrandSymbol"
          Width="64"
          Height="64"
          Margin="0,0,16,0"
          VerticalAlignment="Top"
          FlowDirection="LeftToRight"
          AutomationProperties.Name="{Binding [About_Brand_SymbolName], Source={x:Static local:Loc.Instance}}"
          Source="{StaticResource CpfsSymbolOnDark}" />
        <StackPanel Grid.Column="1">
          <TextBlock
            FontFamily="{DynamicResource CpfsTitleFontFamily}"
            FontSize="20"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{Binding [About_Brand_Name], Source={x:Static local:Loc.Instance}}"
            TextWrapping="Wrap" />
          <TextBlock
            Margin="0,4,0,0"
            Style="{StaticResource CardValue}"
            Text="{Binding [About_Brand_Tagline], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource Body}" Text="{Binding [About_Brand_Description], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </Grid>
    </ui:Card>

    <!--
      Settings-style rows: the names in one column, the values in the next, the copy button at the end of its row.
      Rows are 32 px high (the copy button's height) with 12 px between them, so text, links and button line up.
    -->
    <ui:Card Margin="0,0,0,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="32" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" MinHeight="32" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" MinHeight="32" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource InfoName}" Text="{Binding [About_Version], Source={x:Static local:Loc.Instance}}" />
        <TextBlock
          x:Name="VersionValue"
          Grid.Row="0"
          Style="{StaticResource InfoData}" />
        <ui:Button
          Grid.Row="0"
          Grid.Column="2"
          Margin="8,0,0,0"
          Padding="6"
          VerticalAlignment="Center"
          AutomationProperties.Name="{Binding [About_CopyVersion], Source={x:Static local:Loc.Instance}}"
          Appearance="Transparent"
          Click="OnCopyVersion"
          Icon="{ui:SymbolIcon Copy24}"
          ToolTip="{Binding [About_CopyVersion], Source={x:Static local:Loc.Instance}}" />

        <!--  Links open the page in the browser; the app itself never goes online for them.  -->
        <TextBlock Grid.Row="2" Style="{StaticResource InfoName}" Text="{Binding [About_Homepage], Source={x:Static local:Loc.Instance}}" />
        <ui:HyperlinkButton
          Grid.Row="2"
          Style="{StaticResource InfoLink}"
          AutomationProperties.HelpText="{Binding [About_Homepage_Help], Source={x:Static local:Loc.Instance}}"
          AutomationProperties.Name="{Binding [About_Homepage], Source={x:Static local:Loc.Instance}}"
          Click="OnOpenHomepage"
          ToolTip="{Binding [About_Homepage_Help], Source={x:Static local:Loc.Instance}}">
          <TextBlock x:Name="HomepageText" FlowDirection="LeftToRight" />
        </ui:HyperlinkButton>

        <TextBlock Grid.Row="4" Style="{StaticResource InfoName}" Text="{Binding [About_SourceCode], Source={x:Static local:Loc.Instance}}" />
        <ui:HyperlinkButton
          Grid.Row="4"
          Style="{StaticResource InfoLink}"
          AutomationProperties.HelpText="{Binding [About_GitHub_Help], Source={x:Static local:Loc.Instance}}"
          AutomationProperties.Name="{Binding [About_GitHub], Source={x:Static local:Loc.Instance}}"
          Click="OnOpenGitHub"
          Icon="{ui:SymbolIcon Code24}"
          ToolTip="{Binding [About_GitHub_Help], Source={x:Static local:Loc.Instance}}">
          <TextBlock x:Name="GitHubText" FlowDirection="LeftToRight" />
        </ui:HyperlinkButton>
      </Grid>
    </ui:Card>

    <!--  Goes online only when pressed: one request to GitHub's public releases list, nothing downloaded.  -->
    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSync24}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [About_Update_Title], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [About_Update_Desc], Source={x:Static local:Loc.Instance}}" />
          <TextBlock
            x:Name="UpdateResultText"
            Margin="0,8,0,0"
            AutomationProperties.LiveSetting="Polite"
            Style="{StaticResource Body}"
            Visibility="Collapsed" />
          <ui:Button
            x:Name="OpenReleaseButton"
            Margin="0,8,0,0"
            AutomationProperties.Name="{Binding [Update_OpenRelease], Source={x:Static local:Loc.Instance}}"
            Click="OnOpenRelease"
            Content="{Binding [Update_OpenRelease], Source={x:Static local:Loc.Instance}}"
            Icon="{ui:SymbolIcon Open24}"
            Visibility="Collapsed" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button
        x:Name="CheckUpdatesButton"
        AutomationProperties.Name="{Binding [About_Update_Check], Source={x:Static local:Loc.Instance}}"
        Click="OnCheckUpdates"
        Content="{Binding [About_Update_Check], Source={x:Static local:Loc.Instance}}" />
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PersonSupport24}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [About_Help_Title], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [About_Help_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button
        AutomationProperties.Name="{Binding [About_Log_Copy], Source={x:Static local:Loc.Instance}}"
        Click="OnCopyReport"
        Content="{Binding [About_Log_Copy], Source={x:Static local:Loc.Instance}}"
        Icon="{ui:SymbolIcon Copy24}" />
    </ui:CardControl>

    <ui:InfoBar x:Name="LogResult" Margin="0,0,0,4" IsClosable="True" IsOpen="False" />

    <ui:Card Margin="0,0,0,4">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [About_Licence_Title], Source={x:Static local:Loc.Instance}}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [About_Licence_Code], Source={x:Static local:Loc.Instance}}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [About_Licence_Brand], Source={x:Static local:Loc.Instance}}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [About_Licence_ThirdParty], Source={x:Static local:Loc.Instance}}" />
        <Expander Margin="0,12,0,0" Header="{Binding [About_Licence_Mit], Source={x:Static local:Loc.Instance}}">
          <TextBox x:Name="LicenceMit" AutomationProperties.Name="{Binding [About_Licence_Mit], Source={x:Static local:Loc.Instance}}" Style="{StaticResource LicenceText}" />
        </Expander>
        <Expander Margin="0,4,0,0" Header="{Binding [About_Licence_Notices], Source={x:Static local:Loc.Instance}}">
          <TextBox x:Name="LicenceNotices" AutomationProperties.Name="{Binding [About_Licence_Notices], Source={x:Static local:Loc.Instance}}" Style="{StaticResource LicenceText}" />
        </Expander>
        <Expander Margin="0,4,0,0" Header="{Binding [About_Licence_Ofl], Source={x:Static local:Loc.Instance}}">
          <TextBox x:Name="LicenceOfl" AutomationProperties.Name="{Binding [About_Licence_Ofl], Source={x:Static local:Loc.Instance}}" Style="{StaticResource LicenceText}" />
        </Expander>
      </StackPanel>
    </ui:Card>

  </StackPanel>
</Page>
