<Page
  x:Class="Cpfs.Pages.AboutPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Cpfs"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Page.Resources>
    <Style x:Key="InfoName" BasedOn="{StaticResource CardTitle}" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,16,8" />
    </Style>
    <Style x:Key="InfoValue" BasedOn="{StaticResource CardValue}" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Grid.Column" Value="1" />
    </Style>
    <Style x:Key="InfoData" BasedOn="{StaticResource DataValue}" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <!--  Licence texts: read-only, left to right, scrolled inside a fixed height (the window routes the wheel).  -->
    <Style x:Key="LicenceText" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="MaxHeight" Value="320" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="FlowDirection" Value="LeftToRight" />
      <Setter Property="FontFamily" Value="{x:Static local:Theming.MonoFamily}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Page.Resources>

  <StackPanel Margin="24,16,24,24">
    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Nav_About], Source={x:Static local:Loc.Instance}}" />

    <ui:Card Margin="0,0,0,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image
          x:Name="BrandSymbol"
          Width="64"
          Height="64"
          Margin="0,0,16,0"
          VerticalAlignment="Top"
          FlowDirection="LeftToRight"
          AutomationProperties.Name="{Binding [About_Brand_SymbolName], Source={x:Static local:Loc.Instance}}"
          Source="{StaticResource CpfsSymbolOnDark}" />
        <StackPanel Grid.Column="1">
          <TextBlock
            FontFamily="{DynamicResource CpfsTitleFontFamily}"
            FontSize="20"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{Binding [About_Brand_Name], Source={x:Static local:Loc.Instance}}"
            TextWrapping="Wrap" />
          <!--  Both brand lines carry their label, so a reader can tell the tagline from the motto.  -->
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource InfoName}" Text="{Binding [About_Brand_TaglineLabel], Source={x:Static local:Loc.Instance}}" />
            <TextBlock Grid.Row="0" Style="{StaticResource InfoValue}" Text="{Binding [About_Brand_Tagline], Source={x:Static local:Loc.Instance}}" />
            <TextBlock Grid.Row="1" Style="{StaticResource InfoName}" Text="{Binding [About_Brand_MottoLabel], Source={x:Static local:Loc.Instance}}" />
            <TextBlock Grid.Row="1" Style="{StaticResource InfoValue}" Text="{Binding [About_Brand_Motto], Source={x:Static local:Loc.Instance}}" />
          </Grid>
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Body}" Text="{Binding [About_Brand_Description], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </Grid>
    </ui:Card>

    <ui:Card Margin="0,0,0,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource InfoName}" Text="{Binding [About_Version], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="VersionValue" Grid.Row="0" Style="{StaticResource InfoData}" />
        <TextBlock Grid.Row="1" Style="{StaticResource InfoName}" Text="{Binding [About_Windows], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="WindowsValue" Grid.Row="1" Style="{StaticResource InfoData}" />
        <TextBlock Grid.Row="2" Style="{StaticResource InfoName}" Text="{Binding [About_Framework], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="FrameworkValue" Grid.Row="2" Style="{StaticResource InfoData}" />
        <TextBlock Grid.Row="3" Style="{StaticResource InfoName}" Text="{Binding [About_Backdrop], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="BackdropValue" Grid.Row="3" Style="{StaticResource InfoValue}" />
        <TextBlock Grid.Row="4" Style="{StaticResource InfoName}" Text="{Binding [About_CurrentTheme], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="ThemeValue" Grid.Row="4" Style="{StaticResource InfoData}" />
        <TextBlock Grid.Row="5" Style="{StaticResource InfoName}" Text="{Binding [About_CurrentFont], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="FontValue" Grid.Row="5" Style="{StaticResource InfoData}" />
        <TextBlock Grid.Row="6" Style="{StaticResource InfoName}" Text="{Binding [About_Elevated], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="ElevatedValue" Grid.Row="6" Style="{StaticResource InfoValue}" />
        <TextBlock Grid.Row="7" Style="{StaticResource InfoName}" Text="{Binding [About_Exe], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="ExeValue" Grid.Row="7" Style="{StaticResource InfoData}" />
        <TextBlock Grid.Row="8" Style="{StaticResource InfoName}" Text="{Binding [About_ExeFile], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="ExeFileValue" Grid.Row="8" Style="{StaticResource InfoValue}" />
        <TextBlock Grid.Row="9" Style="{StaticResource InfoName}" Text="{Binding [About_Libraries], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="LibrariesValue" Grid.Row="9" Style="{StaticResource InfoData}" />
        <TextBlock Grid.Row="10" Style="{StaticResource InfoName}" Text="{Binding [About_LogPath], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="LogPathValue" Grid.Row="10" Style="{StaticResource InfoData}" />
        <TextBlock Grid.Row="11" Style="{StaticResource InfoName}" Text="{Binding [About_LogSize], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="LogSizeValue" Grid.Row="11" Style="{StaticResource InfoValue}" />
      </Grid>
    </ui:Card>

    <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DocumentText24}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [About_Log_Title], Source={x:Static local:Loc.Instance}}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [About_Log_Desc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:CardControl.Header>
      <WrapPanel>
        <ui:Button
          Margin="0,0,8,0"
          AutomationProperties.Name="{Binding [About_Log_Open], Source={x:Static local:Loc.Instance}}"
          Click="OnOpenLog"
          Content="{Binding [About_Log_Open], Source={x:Static local:Loc.Instance}}"
          Icon="{ui:SymbolIcon Open24}" />
        <ui:Button
          AutomationProperties.Name="{Binding [About_Log_Copy], Source={x:Static local:Loc.Instance}}"
          Click="OnCopyReport"
          Content="{Binding [About_Log_Copy], Source={x:Static local:Loc.Instance}}"
          Icon="{ui:SymbolIcon Copy24}" />
      </WrapPanel>
    </ui:CardControl>

    <ui:InfoBar x:Name="LogResult" Margin="0,0,0,4" IsClosable="True" IsOpen="False" />

    <ui:Card Margin="0,0,0,4">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [About_Licence_Title], Source={x:Static local:Loc.Instance}}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [About_Licence_Code], Source={x:Static local:Loc.Instance}}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [About_Licence_Brand], Source={x:Static local:Loc.Instance}}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [About_Licence_ThirdParty], Source={x:Static local:Loc.Instance}}" />
        <Expander Margin="0,12,0,0" Header="{Binding [About_Licence_Mit], Source={x:Static local:Loc.Instance}}">
          <TextBox x:Name="LicenceMit" AutomationProperties.Name="{Binding [About_Licence_Mit], Source={x:Static local:Loc.Instance}}" Style="{StaticResource LicenceText}" />
        </Expander>
        <Expander Margin="0,4,0,0" Header="{Binding [About_Licence_Notices], Source={x:Static local:Loc.Instance}}">
          <TextBox x:Name="LicenceNotices" AutomationProperties.Name="{Binding [About_Licence_Notices], Source={x:Static local:Loc.Instance}}" Style="{StaticResource LicenceText}" />
        </Expander>
        <Expander Margin="0,4,0,0" Header="{Binding [About_Licence_Ofl], Source={x:Static local:Loc.Instance}}">
          <TextBox x:Name="LicenceOfl" AutomationProperties.Name="{Binding [About_Licence_Ofl], Source={x:Static local:Loc.Instance}}" Style="{StaticResource LicenceText}" />
        </Expander>
      </StackPanel>
    </ui:Card>

    <ui:Card Margin="0,0,0,4">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [About_Bidi_Title], Source={x:Static local:Loc.Instance}}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [About_Bidi_Desc], Source={x:Static local:Loc.Instance}}" />
        <TextBlock x:Name="BidiSample" Margin="0,8,0,0" Style="{StaticResource Body}" />
      </StackPanel>
    </ui:Card>
  </StackPanel>
</Page>
