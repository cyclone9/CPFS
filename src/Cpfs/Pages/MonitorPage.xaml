<Page
  x:Class="Cpfs.Pages.MonitorPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Cpfs"
  xmlns:pages="clr-namespace:Cpfs.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <Style x:Key="TableHead" BasedOn="{StaticResource CardDescription}" TargetType="TextBlock">
      <Setter Property="Margin" Value="0" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="TableText" BasedOn="{StaticResource CardValue}" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="TableData" BasedOn="{StaticResource DataValue}" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  A stat card: a label, a large number in tabular figures, and one line under it.  -->
    <Style x:Key="StatCard" BasedOn="{StaticResource GroupCard}" TargetType="Border">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!--
      One connected device: who it is (name or address, then how it is connected and for how long), the account and SMB
      version, whether it is active, then Disconnect and a "…" menu with the naming actions. Rows stay across refreshes
      (MonitorPage.SyncRows), so only text that changed is redrawn. No per-device traffic: Windows' per-session byte
      counters stay at 0 during a copy. The first row has no hairline above it.
    -->
    <DataTemplate x:Key="DeviceTemplate" DataType="{x:Type pages:MonitorRow}">
      <StackPanel>
        <Border x:Name="Line" Style="{StaticResource Hairline}" />
        <Grid Margin="20,12" AutomationProperties.Name="{Binding Shown}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <local:TableRowPanel MinLastEms="8">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" Visibility="{Binding HasTitle, Converter={StaticResource Visible}}" />
              <TextBlock Style="{StaticResource DataValue}" Text="{Binding Client}" />
              <TextBlock Style="{StaticResource CardDescription}" Margin="0" Text="{Binding HostName}" Visibility="{Binding HasHostName, Converter={StaticResource Visible}}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Connection}" />
            </StackPanel>
            <StackPanel>
              <TextBlock AutomationProperties.HelpText="{Binding [Monitor_Session_User], Source={x:Static local:Loc.Instance}}" Style="{StaticResource DataValue}" Text="{Binding User}" />
              <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Dialect}" />
            </StackPanel>
            <StackPanel>
              <StackPanel Style="{StaticResource StatusLabel}">
                <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding StatusKind}" />
                <TextBlock Style="{StaticResource Body}" Text="{Binding Status}" />
              </StackPanel>
              <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Files}" />
            </StackPanel>
          </local:TableRowPanel>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
            <ui:Button
              AutomationProperties.Name="{Binding ActionName}"
              Click="OnDisconnect"
              Content="{Binding [Monitor_Session_Disconnect], Source={x:Static local:Loc.Instance}}"
              Visibility="{Binding CanDisconnect, Converter={StaticResource Visible}}" />
            <ui:Button
              Margin="8,0,0,0"
              AutomationProperties.Name="{Binding MoreActionName}"
              Click="OnDeviceMenu"
              Icon="{ui:SymbolIcon MoreHorizontal24}"
              ToolTip="{Binding [Monitor_Device_More], Source={x:Static local:Loc.Instance}}"
              Visibility="{Binding HasActions, Converter={StaticResource Visible}}">
              <ui:Button.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem
                    AutomationProperties.Name="{Binding NameActionName}"
                    Click="OnNameDevice"
                    Header="{Binding [Monitor_Device_Name], Source={x:Static local:Loc.Instance}}"
                    ToolTip="{Binding [Monitor_Device_NameTip], Source={x:Static local:Loc.Instance}}"
                    Visibility="{Binding CanName, Converter={StaticResource Visible}}" />
                  <MenuItem
                    AutomationProperties.Name="{Binding NameActionName}"
                    Click="OnNameDevice"
                    Header="{Binding [Monitor_Device_Rename], Source={x:Static local:Loc.Instance}}"
                    ToolTip="{Binding [Monitor_Device_NameTip], Source={x:Static local:Loc.Instance}}"
                    Visibility="{Binding CanRename, Converter={StaticResource Visible}}" />
                  <MenuItem
                    AutomationProperties.Name="{Binding ForgetActionName}"
                    Click="OnForgetDevice"
                    Header="{Binding [Monitor_Device_Forget], Source={x:Static local:Loc.Instance}}"
                    Visibility="{Binding HasTitle, Converter={StaticResource Visible}}" />
                </ContextMenu>
              </ui:Button.ContextMenu>
            </ui:Button>
          </StackPanel>
        </Grid>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
          <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!--  Failed sign-ins: one header row, then one row per entry, lined up by TableRowPanel.  -->
    <DataTemplate DataType="{x:Type pages:FailRowView}">
      <Border Padding="0,8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <local:TableRowPanel>
          <TextBlock
            AutomationProperties.HelpText="{Binding [Monitor_Fail_Time], Source={x:Static local:Loc.Instance}}"
            Style="{StaticResource TableText}"
            Text="{Binding Time}"
            ToolTip="{Binding Time}" />
          <TextBlock
            AutomationProperties.HelpText="{Binding [Monitor_Fail_User], Source={x:Static local:Loc.Instance}}"
            Style="{StaticResource TableData}"
            Text="{Binding User}"
            ToolTip="{Binding User}" />
          <TextBlock
            AutomationProperties.HelpText="{Binding [Monitor_Fail_From], Source={x:Static local:Loc.Instance}}"
            Style="{StaticResource TableData}"
            Text="{Binding From}"
            ToolTip="{Binding From}" />
          <TextBlock AutomationProperties.HelpText="{Binding [Monitor_Fail_Reason], Source={x:Static local:Loc.Instance}}" Style="{StaticResource CardValue}" Text="{Binding Reason}" />
        </local:TableRowPanel>
      </Border>
    </DataTemplate>

    <!--  Being copied now: the path (one line, trimmed, full path in the tooltip), then the device and account.  -->
    <DataTemplate DataType="{x:Type pages:FileRowView}">
      <Border Padding="0,8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <StackPanel AutomationProperties.HelpText="{Binding [Monitor_File_Path], Source={x:Static local:Loc.Instance}}" ToolTip="{Binding Path}">
          <TextBlock Style="{StaticResource TableData}" Text="{Binding Path}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Who}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!--  One row of Recent activity: Time (mono) and Change size to their widest entry, Path takes the rest.  -->
    <DataTemplate DataType="{x:Type pages:ActivityRowView}">
      <Border Padding="0,8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="ActivityTime" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ActivityChange" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Margin="0,0,16,0" Style="{StaticResource DataValue}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Time}" TextWrapping="NoWrap" />
          <TextBlock Grid.Column="1" Margin="0,0,16,0" Style="{StaticResource CardValue}" Text="{Binding Change}" TextWrapping="NoWrap" />
          <StackPanel Grid.Column="2" AutomationProperties.HelpText="{Binding Tip}" ToolTip="{Binding Tip}">
            <TextBlock Style="{StaticResource DataValue}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <TextBlock
              Style="{StaticResource DataValue}"
              Text="{Binding Second}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap"
              Visibility="{Binding HasSecond, Converter={StaticResource Visible}}" />
            <TextBlock Style="{StaticResource CardValue}" Text="{Binding Note}" Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <StackPanel Style="{StaticResource PageContent}">
    <!--  The title with a quiet "Updated n s ago" and a static dot; nothing pulses.  -->
    <WrapPanel Margin="0,0,0,16">
      <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource PageTitle}" Text="{Binding [Nav_Monitor], Source={x:Static local:Loc.Instance}}" />
      <StackPanel x:Name="UpdatedLabel" VerticalAlignment="Center" Style="{StaticResource StatusLabel}" Visibility="Collapsed">
        <Ellipse x:Name="UpdatedDot" Style="{StaticResource StatusDot}" />
        <TextBlock x:Name="UpdatedText" Style="{StaticResource StatusText}" />
      </StackPanel>
    </WrapPanel>

    <StackPanel x:Name="AdminPanel">
      <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Shield24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Monitor_Admin_Title], Source={x:Static local:Loc.Instance}}" />
            <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Monitor_Admin_Desc], Source={x:Static local:Loc.Instance}}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button
          x:Name="ElevateButton"
          Appearance="Primary"
          AutomationProperties.Name="{Binding [Setup_Admin_Button], Source={x:Static local:Loc.Instance}}"
          Click="OnContinueAsAdministrator"
          Content="{Binding [Setup_Admin_Button], Source={x:Static local:Loc.Instance}}"
          Icon="{ui:SymbolIcon Shield24}" />
      </ui:CardControl>
      <ui:InfoBar x:Name="AdminResult" Margin="0,0,0,8" IsClosable="True" IsOpen="False" />
    </StackPanel>

    <ui:InfoBar x:Name="ActionResult" Margin="0,0,0,8" IsClosable="True" IsOpen="False" />

    <StackPanel x:Name="MonitorPanel" Visibility="Collapsed">
      <!--  Until the first reading arrives (MonitorPage.RefreshAsync).  -->
      <ui:Card x:Name="MonitorLoading" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal">
          <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
          <TextBlock
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Polite"
            Style="{StaticResource CardValue}"
            Text="{Binding [Common_ReadingPc], Source={x:Static local:Loc.Instance}}" />
        </StackPanel>
      </ui:Card>

      <StackPanel x:Name="Readings" Visibility="Collapsed">
        <!--  Four compact numbers from data CPFS already reads: 4 columns from about 150 px each, 2 by 2 when narrow,
              1 when very narrow.  -->
        <local:ColumnsPanel
          EvenRows="True"
          Gap="8"
          ItemChrome="34"
          LogName="Monitor stats"
          MaxColumns="4"
          MinItemEms="8">
          <Border AutomationProperties.Name="{Binding [Monitor_Stat_Devices], Source={x:Static local:Loc.Instance}}" Style="{StaticResource StatCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardDescription}" Margin="0" Text="{Binding [Monitor_Stat_Devices], Source={x:Static local:Loc.Instance}}" />
              <TextBlock x:Name="DevicesNumber" AutomationProperties.LiveSetting="Polite" Style="{StaticResource StatNumber}" />
              <TextBlock x:Name="DevicesSub" Style="{StaticResource CardDescription}" />
            </StackPanel>
          </Border>
          <Border
            AutomationProperties.HelpText="{Binding [Monitor_DownTip], Source={x:Static local:Loc.Instance}}"
            AutomationProperties.Name="{Binding [Monitor_Stat_Down], Source={x:Static local:Loc.Instance}}"
            Style="{StaticResource StatCard}"
            ToolTip="{Binding [Monitor_DownTip], Source={x:Static local:Loc.Instance}}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardDescription}" Margin="0" Text="{Binding [Monitor_Stat_Down], Source={x:Static local:Loc.Instance}}" />
              <TextBlock x:Name="DownNumber" Style="{StaticResource StatNumber}" />
              <TextBlock x:Name="DownSub" Style="{StaticResource CardDescription}" />
            </StackPanel>
          </Border>
          <Border
            AutomationProperties.HelpText="{Binding [Monitor_UpTip], Source={x:Static local:Loc.Instance}}"
            AutomationProperties.Name="{Binding [Monitor_Stat_Up], Source={x:Static local:Loc.Instance}}"
            Style="{StaticResource StatCard}"
            ToolTip="{Binding [Monitor_UpTip], Source={x:Static local:Loc.Instance}}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardDescription}" Margin="0" Text="{Binding [Monitor_Stat_Up], Source={x:Static local:Loc.Instance}}" />
              <TextBlock x:Name="UpNumber" Style="{StaticResource StatNumber}" />
              <TextBlock x:Name="UpSub" Style="{StaticResource CardDescription}" />
            </StackPanel>
          </Border>
          <Border AutomationProperties.Name="{Binding [Monitor_Stat_Fails], Source={x:Static local:Loc.Instance}}" Style="{StaticResource StatCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardDescription}" Margin="0" Text="{Binding [Monitor_Stat_Fails], Source={x:Static local:Loc.Instance}}" />
              <TextBlock x:Name="FailsNumber" AutomationProperties.LiveSetting="Polite" Style="{StaticResource StatNumber}" />
              <StackPanel Margin="0,4,0,0" Style="{StaticResource StatusLabel}">
                <Ellipse x:Name="FailsDot" Style="{StaticResource StatusDot}" />
                <TextBlock x:Name="FailsSub" Style="{StaticResource StatusText}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </local:ColumnsPanel>
        <TextBlock x:Name="ServerError" Margin="0,8,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

        <!--  Connected devices: the main block, one card, one row per device.  -->
        <TextBlock Style="{StaticResource GroupTitle}" Text="{Binding [Monitor_Stat_Devices], Source={x:Static local:Loc.Instance}}" />
        <Border x:Name="DevicesArea" Style="{StaticResource GroupCard}">
          <StackPanel>
            <Border Margin="20,12,20,0" HorizontalAlignment="Left" Style="{StaticResource Badge}" Visibility="{Binding NeedsAdmin, Converter={StaticResource Visible}}">
              <TextBlock Style="{StaticResource BadgeText}" Text="{Binding [Badge_NeedsAdmin], Source={x:Static local:Loc.Instance}}" />
            </Border>
            <TextBlock Margin="20,12" Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
            <TextBlock Margin="20,12" Style="{StaticResource CardValue}" Text="{Binding Empty}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
            <ItemsControl
              x:Name="DeviceList"
              local:TableRowPanel.IsScope="True"
              AlternationCount="2147483647"
              Focusable="False"
              ItemTemplate="{StaticResource DeviceTemplate}"
              ItemsSource="{Binding Rows}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>

    <!--  Recent activity and Being copied now, side by side, stacked when narrow. Recent activity also works without
          administrator rights; Being copied now needs them.  -->
    <local:ColumnsPanel
      x:Name="BottomColumns"
      Margin="0,8,0,0"
      Gap="16"
      LogName="Monitor activity and files"
      MaxColumns="2"
      MinItemEms="22">
      <StackPanel x:Name="ActivityArea" Grid.IsSharedSizeScope="True">
        <Grid Margin="0,16,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitle}" Text="{Binding Title}" />
          <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <ui:ToggleSwitch
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              AutomationProperties.HelpText="{Binding LogHelp}"
              AutomationProperties.Name="{Binding [Monitor_Activity_SaveLog], Source={x:Static local:Loc.Instance}}"
              Click="OnActivityLogSwitch"
              Content="{Binding [Monitor_Activity_SaveLog], Source={x:Static local:Loc.Instance}}"
              IsChecked="{Binding SaveToLog, Mode=OneWay}"
              ToolTip="{Binding LogHelp}" />
            <ui:Button
              VerticalAlignment="Center"
              Appearance="Transparent"
              AutomationProperties.Name="{Binding [Monitor_Activity_Clear], Source={x:Static local:Loc.Instance}}"
              Click="OnClearActivity"
              Content="{Binding [Monitor_Activity_Clear], Source={x:Static local:Loc.Instance}}"
              IsEnabled="{Binding HasItems}"
              ToolTip="{Binding [Monitor_Activity_ClearTip], Source={x:Static local:Loc.Instance}}" />
          </WrapPanel>
        </Grid>
        <ui:Card Padding="20,12">
          <StackPanel>
            <TextBlock Margin="0" Style="{StaticResource CardDescription}" Text="{Binding Description}" />
            <WrapPanel Margin="0,4,0,0" Visibility="{Binding SaveToLog, Converter={StaticResource Visible}}">
              <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource CardDescription}" Text="{Binding LogHelp}" />
              <ui:Button
                Margin="0,4,0,0"
                Appearance="Transparent"
                AutomationProperties.Name="{Binding [About_Log_Open], Source={x:Static local:Loc.Instance}}"
                Click="OnOpenActivityLog"
                Content="{Binding [About_Log_Open], Source={x:Static local:Loc.Instance}}"
                Icon="{ui:SymbolIcon Open24}"
                IsEnabled="{Binding CanOpenLog}" />
            </WrapPanel>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource CardValue}" Text="{Binding Empty}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ActivityTime" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ActivityChange" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,16,0" Style="{StaticResource TableHead}" Text="{Binding [Monitor_Activity_Time], Source={x:Static local:Loc.Instance}}" />
                <TextBlock Grid.Column="1" Margin="0,0,16,0" Style="{StaticResource TableHead}" Text="{Binding [Monitor_Activity_Change], Source={x:Static local:Loc.Instance}}" />
                <TextBlock Grid.Column="2" Style="{StaticResource TableHead}" Text="{Binding [Monitor_Activity_Path], Source={x:Static local:Loc.Instance}}" />
              </Grid>
              <ItemsControl Focusable="False" ItemsSource="{Binding Items}" />
            </StackPanel>
          </StackPanel>
        </ui:Card>
      </StackPanel>

      <StackPanel x:Name="FilesArea">
        <TextBlock Margin="0,16,0,8" Style="{StaticResource CardTitle}" Text="{Binding Title}" />
        <ui:Card Padding="20,12">
          <StackPanel>
            <TextBlock Margin="0" Style="{StaticResource CardDescription}" Text="{Binding Description}" />
            <Border Margin="0,8,0,0" Style="{StaticResource Badge}" Visibility="{Binding NeedsAdmin, Converter={StaticResource Visible}}">
              <TextBlock Style="{StaticResource BadgeText}" Text="{Binding [Badge_NeedsAdmin], Source={x:Static local:Loc.Instance}}" />
            </Border>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource CardValue}" Text="{Binding Empty}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
            <ItemsControl Margin="0,8,0,0" Focusable="False" ItemsSource="{Binding Items}" Visibility="{Binding HasItems, Converter={StaticResource Visible}}" />
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </local:ColumnsPanel>

    <!--  Failed sign-ins: the table only when there is at least one; the 24-hour count is in the stat row.  -->
    <StackPanel x:Name="FailsArea" Visibility="Collapsed">
      <TextBlock Style="{StaticResource GroupTitle}" Text="{Binding Title}" />
      <ui:Card Padding="20,12">
        <StackPanel>
          <TextBlock Margin="0" Style="{StaticResource CardDescription}" Text="{Binding Description}" />
          <StackPanel Margin="0,12,0,0" local:TableRowPanel.IsScope="True">
            <local:TableRowPanel Margin="0,0,0,4">
              <TextBlock Style="{StaticResource TableHead}" Text="{Binding [Monitor_Fail_Time], Source={x:Static local:Loc.Instance}}" />
              <TextBlock Style="{StaticResource TableHead}" Text="{Binding [Monitor_Fail_User], Source={x:Static local:Loc.Instance}}" />
              <TextBlock Style="{StaticResource TableHead}" Text="{Binding [Monitor_Fail_From], Source={x:Static local:Loc.Instance}}" />
              <TextBlock Style="{StaticResource CardDescription}" Margin="0" Text="{Binding [Monitor_Fail_Reason], Source={x:Static local:Loc.Instance}}" />
            </local:TableRowPanel>
            <ItemsControl Focusable="False" ItemsSource="{Binding Items}" />
          </StackPanel>
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </StackPanel>
</Page>
