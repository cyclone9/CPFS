<Page
  x:Class="Cpfs.Pages.MonitorPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Cpfs"
  xmlns:pages="clr-namespace:Cpfs.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!--  One label and value; fields sit in a WrapPanel, so a row folds onto more lines in a narrow window.  -->
    <DataTemplate DataType="{x:Type pages:MonitorField}">
      <StackPanel MinWidth="104" Margin="0,0,24,8">
        <!--  Down and Up explain their direction in a tooltip, for the mouse and for screen readers.  -->
        <TextBlock
          Margin="0"
          AutomationProperties.HelpText="{Binding Tip}"
          Style="{StaticResource CardDescription}"
          Text="{Binding Label}"
          ToolTip="{Binding Tip}" />
        <TextBlock Style="{StaticResource DataValue}" Text="{Binding Value}" Visibility="{Binding IsData, Converter={StaticResource Visible}}" />
        <TextBlock Style="{StaticResource CardValue}" Text="{Binding Value}" Visibility="{Binding IsText, Converter={StaticResource Visible}}" />
        <TextBlock Style="{StaticResource CardDescription}" Margin="0" Text="{Binding Detail}" TextWrapping="Wrap" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
      </StackPanel>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="Wrap">
      <WrapPanel />
    </ItemsPanelTemplate>

    <DataTemplate DataType="{x:Type pages:MonitorRow}">
      <Border
        Margin="0,4,0,0"
        Padding="12,8,12,0"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <!--
          The device's data on the start side, its buttons in one column of equal widths on the end side; in a narrow
          window the buttons go below the data. The two naming buttons never show together.
        -->
        <local:FieldCardPanel FieldAutoWidth="True" MinHeaderEms="16">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,6" Text="{Binding Title}" TextWrapping="Wrap" Visibility="{Binding HasTitle, Converter={StaticResource Visible}}" />
            <Border Style="{StaticResource Badge}" Margin="0,0,0,6" Visibility="{Binding HasBadge, Converter={StaticResource Visible}}">
              <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Badge}" />
            </Border>
            <ItemsControl Focusable="False" ItemsPanel="{StaticResource Wrap}" ItemsSource="{Binding Fields}" />
          </StackPanel>
          <StackPanel Margin="0,0,0,4" Visibility="{Binding HasActions, Converter={StaticResource Visible}}">
            <ui:Button
              Margin="0,0,0,4"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              AutomationProperties.Name="{Binding NameActionName}"
              Click="OnNameDevice"
              Content="{Binding [Monitor_Device_Name], Source={x:Static local:Loc.Instance}}"
              Icon="{ui:SymbolIcon Tag24}"
              ToolTip="{Binding [Monitor_Device_NameTip], Source={x:Static local:Loc.Instance}}"
              Visibility="{Binding CanName, Converter={StaticResource Visible}}" />
            <ui:Button
              Margin="0,0,0,4"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              AutomationProperties.Name="{Binding NameActionName}"
              Click="OnNameDevice"
              Content="{Binding [Monitor_Device_Rename], Source={x:Static local:Loc.Instance}}"
              Icon="{ui:SymbolIcon Rename24}"
              ToolTip="{Binding [Monitor_Device_NameTip], Source={x:Static local:Loc.Instance}}"
              Visibility="{Binding HasTitle, Converter={StaticResource Visible}}" />
            <ui:Button
              Margin="0,0,0,4"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              AutomationProperties.Name="{Binding ForgetActionName}"
              Click="OnForgetDevice"
              Content="{Binding [Monitor_Device_Forget], Source={x:Static local:Loc.Instance}}"
              Icon="{ui:SymbolIcon Delete24}"
              Visibility="{Binding HasTitle, Converter={StaticResource Visible}}" />
            <ui:Button
              Margin="0,0,0,4"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              AutomationProperties.Name="{Binding ActionName}"
              Click="OnDisconnect"
              Content="{Binding [Monitor_Session_Disconnect], Source={x:Static local:Loc.Instance}}"
              Icon="{ui:SymbolIcon PlugDisconnected24}"
              Visibility="{Binding CanDisconnect, Converter={StaticResource Visible}}" />
          </StackPanel>
        </local:FieldCardPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="SectionTemplate" DataType="{x:Type pages:MonitorSection}">
      <ui:Card Margin="0,0,0,4">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
          <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Description}" />
          <Border Style="{StaticResource Badge}" Margin="0,8,0,0" Visibility="{Binding NeedsAdmin, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding [Badge_NeedsAdmin], Source={x:Static local:Loc.Instance}}" />
          </Border>
          <TextBlock Margin="0,8,0,0" Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource CardValue}" Text="{Binding Empty}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
          <ItemsControl
            Margin="0,8,0,0"
            Focusable="False"
            ItemsPanel="{StaticResource Wrap}"
            ItemsSource="{Binding Fields}" />
          <ItemsControl Focusable="False" ItemsSource="{Binding Rows}" />
        </StackPanel>
      </ui:Card>
    </DataTemplate>
  </Page.Resources>

  <StackPanel Margin="24,16,24,24">
    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Nav_Monitor], Source={x:Static local:Loc.Instance}}" />

    <StackPanel x:Name="AdminPanel">
      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Shield24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Monitor_Admin_Title], Source={x:Static local:Loc.Instance}}" />
            <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Monitor_Admin_Desc], Source={x:Static local:Loc.Instance}}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button
          x:Name="ElevateButton"
          Appearance="Primary"
          AutomationProperties.Name="{Binding [Setup_Admin_Button], Source={x:Static local:Loc.Instance}}"
          Click="OnContinueAsAdministrator"
          Content="{Binding [Setup_Admin_Button], Source={x:Static local:Loc.Instance}}"
          Icon="{ui:SymbolIcon Shield24}" />
      </ui:CardControl>
      <ui:InfoBar x:Name="AdminResult" Margin="0,0,0,4" IsClosable="True" IsOpen="False" />
    </StackPanel>

    <StackPanel x:Name="MonitorPanel" Visibility="Collapsed">
      <ui:InfoBar x:Name="ActionResult" Margin="0,0,0,4" IsClosable="True" IsOpen="False" />
      <ItemsControl x:Name="Sections" Focusable="False" ItemTemplate="{StaticResource SectionTemplate}" />
    </StackPanel>
  </StackPanel>
</Page>
