<Page
  x:Class="Cpfs.Pages.ConnectPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Cpfs"
  xmlns:pages="clr-namespace:Cpfs.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!--  A neutral note: quiet secondary text with an info icon.  -->
    <DataTemplate DataType="{x:Type pages:NoteItem}">
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon
          Margin="0,0,8,0"
          VerticalAlignment="Top"
          FontSize="16"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Symbol="Info24" />
        <TextBlock Grid.Column="1" Margin="0" Style="{StaticResource CardDescription}" Text="{Binding Text}" />
      </Grid>
    </DataTemplate>

    <!--  A requirement the user must meet, not a step: a warning bar that can't be closed.  -->
    <DataTemplate DataType="{x:Type pages:WarningItem}">
      <ui:InfoBar
        Margin="0,8,0,0"
        AutomationProperties.Name="{Binding Text}"
        IsClosable="False"
        IsOpen="True"
        Message="{Binding Text}"
        Severity="Warning" />
    </DataTemplate>

    <!--  The value is data: monospace, left to right inside RTL text. The button copies exactly what is shown.  -->
    <DataTemplate DataType="{x:Type pages:ValueItem}">
      <StackPanel Margin="0,8,0,0">
        <TextBlock Margin="0,0,0,4" Style="{StaticResource CardDescription}" Text="{Binding Label}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border
            Padding="12,8"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            CornerRadius="4">
            <TextBlock
              VerticalAlignment="Center"
              AutomationProperties.Name="{Binding Label}"
              Style="{StaticResource DataValue}"
              Text="{Binding Value}" />
          </Border>
          <ui:Button
            Grid.Column="1"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            AutomationProperties.Name="{Binding CopyName}"
            Click="OnCopy"
            Icon="{ui:SymbolIcon Copy24}"
            ToolTip="{Binding CopyName}" />
        </Grid>
      </StackPanel>
    </DataTemplate>

    <!--  A numbered step: a 24 px number circle, the text, and the values it needs right under it.  -->
    <DataTemplate x:Key="StepTemplate" DataType="{x:Type pages:GuideStep}">
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
          Width="24"
          Height="24"
          Margin="0,0,12,0"
          VerticalAlignment="Top"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="12">
          <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding Number}" />
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Body}" Text="{Binding Text}" />
          <ItemsControl Focusable="False" ItemsSource="{Binding Values}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!--
      One device's guide: the numbered steps, then its notes; for the phones the QR code beside the steps, or under
      them when the window is narrow (FieldCardPanel). The code is always dark on white with its quiet zone, never
      mirrored, and holds no password.
    -->
    <DataTemplate x:Key="GuideTemplate" DataType="{x:Type pages:GuideCard}">
      <Border Margin="0,16,0,0" Padding="20" Style="{StaticResource GroupCard}">
        <local:FieldCardPanel FieldAutoWidth="True" MinHeaderEms="18">
          <StackPanel>
            <ItemsControl Focusable="False" ItemTemplate="{StaticResource StepTemplate}" ItemsSource="{Binding Steps}" />
            <ItemsControl Focusable="False" ItemsSource="{Binding Notes}" />
          </StackPanel>
          <StackPanel Width="240" Visibility="{Binding HasQr, Converter={StaticResource Visible}}">
            <Border
              Padding="12"
              HorizontalAlignment="Center"
              Background="White"
              CornerRadius="8">
              <Image
                Width="216"
                Height="216"
                AutomationProperties.Name="{Binding Qr.Name}"
                FlowDirection="LeftToRight"
                RenderOptions.EdgeMode="Aliased"
                Source="{Binding Qr.Image}" />
            </Border>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource CardDescription}" Text="{Binding Qr.Caption}" TextAlignment="Center" />
            <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Connect_Qr_NoPassword], Source={x:Static local:Loc.Instance}}" TextAlignment="Center" />
            <ContentControl Margin="0,4,0,0" Content="{Binding Qr.Value}" Focusable="False" />
          </StackPanel>
        </local:FieldCardPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AddressTemplate" DataType="{x:Type pages:AddressOption}">
      <StackPanel Margin="0,4">
        <TextBlock Style="{StaticResource DataValue}" Text="{Binding Host}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Description}" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <StackPanel Style="{StaticResource PageContent}">
    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Nav_Connect], Source={x:Static local:Loc.Instance}}" />
    <TextBlock Margin="0,0,0,16" Style="{StaticResource Body}" Text="{Binding [Connect_Intro], Source={x:Static local:Loc.Instance}}" />

    <!--  Every bar that applies stays visible: nothing a user must know is hidden.  -->
    <ui:InfoBar x:Name="ConfigInfo" Margin="0,0,0,8" IsClosable="False" IsOpen="False" />
    <ui:InfoBar x:Name="RenameInfo" Margin="0,0,0,8" IsClosable="True" IsOpen="False" Severity="Warning" />
    <ui:InfoBar x:Name="StrictInfo" Margin="0,0,0,8" IsClosable="True" IsOpen="False" Severity="Informational" />

    <!--  Connection details: the share address (the brand signature, its \\ in the accent), where it works, the address
          chooser and Copy; then the username.  -->
    <Border AutomationProperties.Name="{Binding [Connect_Details_Title], Source={x:Static local:Loc.Instance}}" Style="{StaticResource GroupCard}">
      <StackPanel>
        <Border Style="{StaticResource SettingsRow}">
          <local:FieldCardPanel FieldAutoWidth="True" MinHeaderEms="16">
            <StackPanel VerticalAlignment="Center">
              <TextBlock
                x:Name="AddressText"
                AutomationProperties.Name="{Binding [Connect_Label_Unc], Source={x:Static local:Loc.Instance}}"
                FontSize="20"
                Style="{StaticResource Signature}">
                <Run x:Name="AddressSlashes" Foreground="{DynamicResource CpfsSignatureBrush}" /><Run x:Name="AddressRest" />
              </TextBlock>
              <TextBlock x:Name="WhereText" Style="{StaticResource CardDescription}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
              <ComboBox
                x:Name="AddressBox"
                MinWidth="160"
                MaxWidth="280"
                AutomationProperties.HelpText="{Binding [Connect_Address_Desc], Source={x:Static local:Loc.Instance}}"
                AutomationProperties.Name="{Binding [Connect_Address_Title], Source={x:Static local:Loc.Instance}}"
                ItemTemplate="{StaticResource AddressTemplate}"
                SelectionChanged="OnAddressSelected" />
              <ui:Button
                x:Name="RefreshButton"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding [Connect_Address_Refresh], Source={x:Static local:Loc.Instance}}"
                Click="OnRefresh"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                ToolTip="{Binding [Connect_Address_Refresh], Source={x:Static local:Loc.Instance}}" />
              <ui:Button
                x:Name="CopyAddressButton"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Click="OnCopyAddress"
                Content="{Binding [Common_Copy], Source={x:Static local:Loc.Instance}}" />
            </StackPanel>
          </local:FieldCardPanel>
        </Border>
        <Border Style="{StaticResource Hairline}" />
        <Border Style="{StaticResource SettingsRow}">
          <local:FieldCardPanel FieldAutoWidth="True" MinHeaderEms="16">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource CardValue}" Text="{Binding [Connect_Label_User], Source={x:Static local:Loc.Instance}}" />
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
              <TextBlock
                x:Name="UserText"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding [Connect_Label_User], Source={x:Static local:Loc.Instance}}"
                Style="{StaticResource DataValue}" />
              <ui:Button
                x:Name="CopyUserButton"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Click="OnCopyUser"
                Content="{Binding [Common_Copy], Source={x:Static local:Loc.Instance}}" />
            </StackPanel>
          </local:FieldCardPanel>
        </Border>
      </StackPanel>
    </Border>

    <!--  Device tabs, phones first. One guide shows at a time; the last choice is kept in preferences.json.  -->
    <TabControl
      x:Name="Tabs"
      Margin="0,24,0,0"
      AutomationProperties.Name="{Binding [Connect_Tabs_Name], Source={x:Static local:Loc.Instance}}"
      ContentTemplate="{StaticResource GuideTemplate}"
      SelectionChanged="OnTabChanged">
      <TabControl.ItemContainerStyle>
        <Style BasedOn="{StaticResource {x:Type TabItem}}" TargetType="TabItem">
          <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>
      </TabControl.ItemContainerStyle>
      <TabControl.ItemTemplate>
        <DataTemplate DataType="{x:Type pages:GuideCard}">
          <TextBlock Text="{Binding Title}" />
        </DataTemplate>
      </TabControl.ItemTemplate>
    </TabControl>
  </StackPanel>
</Page>
