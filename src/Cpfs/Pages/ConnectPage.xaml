<Page
  x:Class="Cpfs.Pages.ConnectPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Cpfs"
  xmlns:pages="clr-namespace:Cpfs.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <DataTemplate DataType="{x:Type pages:StepItem}">
      <TextBlock Margin="0,4,0,4" Style="{StaticResource Body}" Text="{Binding Text}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:NoteItem}">
      <Border
        Margin="0,6,0,2"
        Padding="12,8"
        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
        CornerRadius="4">
        <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Text}" />
      </Border>
    </DataTemplate>

    <!--  The value is data: monospace, left to right inside RTL text. The button copies exactly what is shown.  -->
    <DataTemplate DataType="{x:Type pages:ValueItem}">
      <StackPanel Margin="0,6,0,2">
        <TextBlock Margin="0,0,0,2" Style="{StaticResource CardDescription}" Text="{Binding Label}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border
            Padding="8,6"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            CornerRadius="4">
            <TextBlock
              VerticalAlignment="Center"
              AutomationProperties.Name="{Binding Label}"
              Style="{StaticResource DataValue}"
              Text="{Binding Value}" />
          </Border>
          <ui:Button
            Grid.Column="1"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            AutomationProperties.Name="{Binding CopyName}"
            Click="OnCopy"
            Icon="{ui:SymbolIcon Copy24}"
            ToolTip="{Binding CopyName}" />
        </Grid>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GuideCardTemplate" DataType="{x:Type pages:GuideCard}">
      <!--  Stretch: the cards of one row share the height of the tallest.  -->
      <ui:Card VerticalAlignment="Stretch" VerticalContentAlignment="Top">
        <StackPanel>
          <!--  Name on the start side, the QR button (where the device can use a code) at the top of the end side.  -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              FontSize="20"
              Symbol="{Binding Icon}" />
            <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              FontSize="16"
              Style="{StaticResource CardTitle}"
              Text="{Binding Title}"
              TextWrapping="Wrap" />
            <ui:Button
              Grid.Column="2"
              Margin="8,0,0,0"
              VerticalAlignment="Top"
              AutomationProperties.Name="{Binding QrButtonName}"
              Click="OnShowQr"
              Content="{Binding [Connect_Qr_Show], Source={x:Static local:Loc.Instance}}"
              Icon="{ui:SymbolIcon QrCode24}"
              ToolTip="{Binding QrButtonName}"
              Visibility="{Binding HasQr, Converter={StaticResource Visible}}" />
          </Grid>
          <ItemsControl Margin="0,8,0,0" Focusable="False" ItemsSource="{Binding Items}" />
        </StackPanel>
      </ui:Card>
    </DataTemplate>

    <DataTemplate x:Key="AddressTemplate" DataType="{x:Type pages:AddressOption}">
      <StackPanel Margin="0,2,0,2">
        <TextBlock Style="{StaticResource DataValue}" Text="{Binding Host}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Description}" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <StackPanel Margin="24,16,24,24">
    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Nav_Connect], Source={x:Static local:Loc.Instance}}" />
    <TextBlock Margin="0,0,0,12" Style="{StaticResource Body}" Text="{Binding [Connect_Intro], Source={x:Static local:Loc.Instance}}" />

    <ui:InfoBar x:Name="ConfigInfo" Margin="0,0,0,4" IsClosable="False" IsOpen="False" />
    <ui:InfoBar x:Name="RenameInfo" Margin="0,0,0,4" IsClosable="True" IsOpen="False" Severity="Warning" />
    <ui:InfoBar x:Name="StrictInfo" Margin="0,0,0,4" IsClosable="True" IsOpen="False" Severity="Informational" />

    <ui:Card Margin="0,0,0,4">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Connect_Address_Title], Source={x:Static local:Loc.Instance}}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Connect_Address_Desc], Source={x:Static local:Loc.Instance}}" />
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox
            x:Name="AddressBox"
            AutomationProperties.Name="{Binding [Connect_Address_Title], Source={x:Static local:Loc.Instance}}"
            ItemTemplate="{StaticResource AddressTemplate}"
            SelectionChanged="OnAddressSelected" />
          <ui:Button
            x:Name="RefreshButton"
            Grid.Column="1"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            AutomationProperties.Name="{Binding [Connect_Address_Refresh], Source={x:Static local:Loc.Instance}}"
            Click="OnRefresh"
            Icon="{ui:SymbolIcon ArrowClockwise24}"
            ToolTip="{Binding [Connect_Address_Refresh], Source={x:Static local:Loc.Instance}}" />
        </Grid>
        <TextBlock x:Name="WhereText" Margin="0,8,0,0" Style="{StaticResource CardValue}" />
      </StackPanel>
    </ui:Card>

    <ui:Card Margin="0,0,0,4">
      <StackPanel>
        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Connect_Account_Title], Source={x:Static local:Loc.Instance}}" />
        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding [Connect_Account_Desc], Source={x:Static local:Loc.Instance}}" />
        <ItemsControl x:Name="AccountItems" Margin="0,4,0,0" Focusable="False" />
      </StackPanel>
    </ui:Card>

    <!--
      One client card per column, two columns when both fit. The minimum card is 20 ems of text, about 40 characters
      of a step and room for a code box with its copy button, plus the card's padding and border (14 + 14 + 2). At the
      default window size the content area holds two.
    -->
    <ItemsControl x:Name="Guides" Focusable="False" ItemTemplate="{StaticResource GuideCardTemplate}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <local:ColumnsPanel
            Gap="4"
            ItemChrome="30"
            LogName="Connect guide"
            MaxColumns="2"
            MinItemEms="20" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </StackPanel>
</Page>
